{
	"files": {
		"includes": [
			"*.json",
			"src/**/*.ts",
			"scripts/*.js",
			"test/*.js"
		]
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"indentWidth": 4,
			"lineWidth": 80,
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"indentStyle": "tab"
		}
	}
}
